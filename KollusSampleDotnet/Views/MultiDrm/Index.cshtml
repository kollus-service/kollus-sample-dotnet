@* Player MultiDRM — 서버가 Web.config의 Multi DRM 채널 키·DoveRunner 키로 라이선스 토큰과 drm_policy JWT를 생성해
   Widevine/PlayReady(DASH) 또는 FairPlay(HLS) 보호 콘텐츠를 웹 플레이어로 재생하는 페이지 *@
@{
    ViewBag.Title = "Multi DRM Sample";
}

<div style="max-width:720px; margin:50px auto;">
    <h2>Multi DRM Sample</h2>

    <!-- Basic Settings -->
    <div class="panel panel-default">
        <div class="panel-heading"><strong>Basic Settings</strong></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>MCK (Media Content Key)</label>
                        <input id="mckey" type="text" class="form-control" value="@ViewBag.DefaultMck" placeholder="e.g. NNHk8cm6" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>CUID (Viewer ID)</label>
                        <input id="cuid" type="text" class="form-control" value="sample_user" />
                    </div>
                </div>
            </div>
            <p class="help-block" style="font-size:12px; margin-bottom:0;">
                Channel keys (<code>Kollus.MultiDrm.SecurityKey</code> / <code>Kollus.MultiDrm.CustomKey</code>) and DoveRunner keys
                are read from <code>Web.config</code> on the server and are not entered here.
            </p>
        </div>
    </div>

    <!-- DRM Settings -->
    <div class="panel panel-default">
        <div class="panel-heading"><strong>DRM Settings</strong></div>
        <div class="panel-body">

            <div class="form-group">
                <label>Streaming Type</label>
                <select id="streamingType" class="form-control" onchange="handleStreamingTypeChange()">
                    <option value="dash">DASH &mdash; Widevine / PlayReady (Android, Chrome, Edge)</option>
                    <option value="hls">HLS &mdash; FairPlay (Safari, iOS, iPadOS)</option>
                </select>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>DoveRunner Site ID <small class="text-muted">(from Web.config)</small></label>
                        <input id="siteId" type="text" class="form-control" value="@ViewBag.DefaultSiteId" readonly />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Upload File Key <small class="text-muted">(Content ID)</small></label>
                        <input id="uploadFileKey" type="text" class="form-control" value="@ViewBag.DefaultUploadFileKey" placeholder="e.g. abc123..." />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>License Token <small class="text-muted">(Base64 &mdash; generated by the server, read-only)</small></label>
                <div class="input-group">
                    <input id="licenseToken" type="text" class="form-control" placeholder="Click Generate to preview the server-generated token" readonly />
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" onclick="handleGenerateLicenseToken()">Generate</button>
                    </span>
                </div>
                <p class="help-block" style="font-size:12px;">
                    Preview only. Calls <code>/MultiDrm/GenerateLicenseToken</code> with Upload File Key + Streaming Type.
                    When playing, the server generates the token again and embeds it in the JWT, so it cannot be edited here.
                </p>
            </div>

        </div>
    </div>

    <button id="playBtn" onclick="handleGenerateAndPlay()" class="btn btn-primary btn-block">Generate &amp; Play</button>

    <div id="errorMsg" class="alert alert-danger" style="display:none; margin-top:12px;"></div>

    <!-- Player -->
    <div id="playerSection" style="display:none; margin-top:20px;">
        <div class="panel panel-default">
            <div class="panel-heading"><strong>Web Player</strong></div>
            <div class="panel-body" style="padding:0;">
                <div style="position:relative; width:100%; padding-top:56.25%;">
                    <iframe id="drmIframe" src="about:blank"
                        style="position:absolute; top:0; left:0; width:100%; height:100%; border:none;"
                        allowfullscreen
                        allow="local-network-access; loopback-network; accelerometer; autoplay; encrypted-media; fullscreen; picture-in-picture;">
                    </iframe>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><strong>Play URL</strong></div>
            <div class="panel-body">
                <a id="playUrlDisplay" href="#" target="_blank" style="word-break:break-all; font-size:11px;"></a>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><strong>DRM Info</strong></div>
            <div class="panel-body" style="font-size:12px; color:#555;">
                <table class="table table-condensed" style="margin:0;">
                    <tr><th style="width:160px;">Type</th><td id="infoType"></td></tr>
                    <tr><th>License Server</th><td><code>https://drm-license.doverunner.com/ri/licenseManager.do</code></td></tr>
                    <tr id="certRow" style="display:none;"><th>Certificate URL</th><td id="infoCertUrl" style="word-break:break-all;"></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
const DEFAULT_CUID       = 'sample_user';
const STREAMING_TYPE_HLS = 'hls';
// FairPlay(HLS) 인증서 URL — 서버(KollusMultiDrmService)가 JWT drm_policy.certificate_url에 넣는 것과 같은 형식. 화면 표시용
const DOVE_RUNNER_CERT_URL_BASE = 'https://drm-license.doverunner.com/ri/fpsKeyManager.do?siteId=';

/**
 * Streaming Type 변경 핸들러 — 라이선스 토큰은 스트리밍 타입(DASH=Widevine / HLS=FairPlay)에 따라 달라지므로
 * 이전에 미리보기로 생성해 둔 토큰을 지운다.
 */
function handleStreamingTypeChange() {
    document.getElementById('licenseToken').value = '';
}

/**
 * License Token의 Generate 버튼 클릭 핸들러 — 서버에 토큰 생성을 요청해 읽기 전용 필드에 미리보기로 표시한다.
 * 실제 재생 시에는 서버가 토큰을 다시 생성해 JWT에 넣으므로 이 값은 확인용이다.
 */
async function handleGenerateLicenseToken() {
    const uploadFileKey = document.getElementById('uploadFileKey').value.trim();
    if (!uploadFileKey) {
        alert('Please enter the Upload File Key first.');
        return;
    }
    try {
        const streamingType = document.getElementById('streamingType').value;
        // POST /MultiDrm/GenerateLicenseToken(uploadFileKey, streamingType) — 서버가 Web.config의 DoveRunner
        // Site Key/Access Key/Site ID로 재생 정책을 AES-256-CBC 암호화하고 SHA256 해시를 붙인 Base64 토큰을 반환
        const res = await fetch('/MultiDrm/GenerateLicenseToken', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'uploadFileKey=' + encodeURIComponent(uploadFileKey)
                + '&streamingType=' + encodeURIComponent(streamingType)
        });
        // 응답: { success, license_token } — 실패 시 { success: false, message }
        const data = await res.json();
        if (data.success) {
            document.getElementById('licenseToken').value = data.license_token;
        } else {
            alert('Error: ' + data.message);
        }
    } catch (err) {
        // 네트워크 오류나 서버가 JSON이 아닌 응답을 보낸 경우 — 미리보기용 호출이므로 알림만 띄우고 재생 흐름에는 영향 없음
        alert('Error: ' + err.message);
    }
}

/**
 * Generate & Play 버튼 클릭 핸들러 — /MultiDrm/GeneratePlayUrl로 drm_policy가 담긴 플레이어 JWT URL을 받아
 * iframe 플레이어와 DRM 정보 패널을 채운다.
 */
async function handleGenerateAndPlay() {
    const mckey         = document.getElementById('mckey').value.trim();
    const uploadFileKey = document.getElementById('uploadFileKey').value.trim();
    const streamingType = document.getElementById('streamingType').value;
    const siteId        = document.getElementById('siteId').value.trim();

    if (!mckey) { showError('Please enter an MCK.'); return; }
    if (!uploadFileKey) { showError('Please enter the Upload File Key.'); return; }

    document.getElementById('errorMsg').style.display = 'none';
    document.getElementById('playerSection').style.display = 'none';

    const btn = document.getElementById('playBtn');
    btn.textContent = 'Generating...';
    btn.disabled = true;

    try {
        // POST /MultiDrm/GeneratePlayUrl — 바디 필드는 서버 MultiDrmJwtOptions 프로퍼티와 일치(ExpireSeconds는 서버 기본값).
        // 채널 키와 DoveRunner 키는 서버 Web.config 값을 쓰고, 라이선스 토큰도 서버가 UploadFileKey·StreamingType으로
        // 새로 생성해 JWT의 mc[].drm_policy.data.custom_header에 넣는다
        const body = {
            ClientUserId:    document.getElementById('cuid').value.trim() || DEFAULT_CUID,
            MediaContentKey: mckey,
            UploadFileKey:   uploadFileKey,
            StreamingType:   streamingType
        };

        const res = await fetch('/MultiDrm/GeneratePlayUrl', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        // 응답: { success, play_url } — play_url은 drm_policy JWT가 담긴 웹 플레이어 URL(/s?jwt=&custom_key=)
        const data = await res.json();
        if (!data.success) { showError(data.message || 'Failed to generate play URL.'); return; }

        const url = data.play_url;
        document.getElementById('drmIframe').src = url;
        const linkEl = document.getElementById('playUrlDisplay');
        linkEl.href = url;
        linkEl.textContent = url;

        document.getElementById('infoType').textContent = streamingType === STREAMING_TYPE_HLS
            ? 'HLS / FairPlay' : 'DASH / Widevine + PlayReady';

        // FairPlay(HLS)만 사이트별 인증서 URL이 필요하므로 HLS일 때만 표시
        const certRow = document.getElementById('certRow');
        if (streamingType === STREAMING_TYPE_HLS) {
            document.getElementById('infoCertUrl').textContent = DOVE_RUNNER_CERT_URL_BASE + siteId;
            certRow.style.display = '';
        } else {
            certRow.style.display = 'none';
        }

        document.getElementById('playerSection').style.display = 'block';
    } catch (err) {
        // 네트워크 오류나 서버가 JSON이 아닌 응답(오류 페이지 등)을 보낸 경우 —
        // 원인을 화면에 보여주고, finally에서 버튼을 복구해 재시도할 수 있게 한다
        showError('Error: ' + err.message);
    } finally {
        btn.textContent = 'Generate & Play';
        btn.disabled = false;
    }
}

/**
 * 오류 메시지 영역에 메시지를 표시한다.
 * @@param {string} msg 표시할 메시지
 */
function showError(msg) {
    const el = document.getElementById('errorMsg');
    el.textContent = msg;
    el.style.display = 'block';
}
</script>
