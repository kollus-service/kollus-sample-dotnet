@* File Upload — 서버 프록시(/api/upload/create-url)로 Kollus 업로드 URL을 발급받은 뒤,
   브라우저가 그 URL로 파일을 직접 multipart POST하며 진행률을 표시하는 페이지 *@
@{
    ViewBag.Title = "Kollus File Upload";
}

<div style="max-width:800px; margin:50px auto;">
    <h2>Kollus File Upload</h2>

    <div class="form-group">
        <label>API Token</label>
        <input id="apiToken" type="text" class="form-control" value="@ViewBag.DefaultApiToken" />
    </div>
    <div class="form-group">
        <label>Title</label>
        <input id="title" type="text" class="form-control" placeholder="Video title" />
    </div>
    <div class="form-group">
        <label>Category Key</label>
        <input id="categoryKey" type="text" class="form-control" value="@ViewBag.DefaultCategoryKey" />
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label>Encryption</label>
                <select id="isEncryption" class="form-control">
                    <option value="1">Encrypted content</option>
                    <option value="0">Plain (unencrypted) content</option>
                </select>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label>Content Type</label>
                <select id="isAudio" class="form-control">
                    <option value="0">Video</option>
                    <option value="1">Audio only</option>
                </select>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label>Select File</label>
        <input id="fileInput" type="file" accept="video/*,audio/*" />
    </div>

    <button id="uploadBtn" type="button" class="btn btn-primary">Start Upload</button>

    <div id="uploadInfo" class="panel panel-default" style="margin-top:20px; display:none;">
        <div class="panel-body" id="uploadDetails"></div>
    </div>

    <div id="progressArea" style="margin-top:16px; display:none;">
        <div style="width:100%; height:28px; background:#e0e0e0; border-radius:4px; overflow:hidden; position:relative;">
            <div id="progressBar" style="height:100%; background:#5cb85c; width:0%; transition:width 0.3s;"></div>
            <div id="progressText" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-weight:bold; color:#333;">0%</div>
        </div>
    </div>

    <div id="completeInfo" class="alert alert-success" style="margin-top:12px; display:none;">
        Upload complete &mdash; encoding has started.
    </div>
</div>

<script>
// 업로드 URL 유효 시간(초) — 서버 KollusDefaults.UploadUrlExpireSeconds와 동일한 값을 ViewBag으로 받음
const DEFAULT_UPLOAD_EXPIRE_TIME = @ViewBag.DefaultUploadExpireTime;
// 업로드 XHR 응답을 성공으로 판정하는 HTTP 상태 코드 범위(2xx)
const HTTP_STATUS_SUCCESS_MIN = 200;
const HTTP_STATUS_SUCCESS_MAX = 299;
// 진행률 표시용 백분율 배율
const PERCENT_SCALE = 100;

const UPLOAD_BUTTON_LABEL_IDLE       = 'Start Upload';
const UPLOAD_BUTTON_LABEL_PROCESSING = 'Processing...';
const UPLOAD_BUTTON_LABEL_DONE       = 'Upload Complete';

/**
 * 업로드 버튼의 활성 상태와 문구를 바꾼다.
 * @@param {boolean} disabled 버튼 비활성화 여부
 * @@param {string} label 버튼에 표시할 문구
 */
function setUploadButton(disabled, label) {
    const btn = document.getElementById('uploadBtn');
    btn.disabled = disabled;
    btn.textContent = label;
}

/**
 * Start Upload 버튼 클릭 핸들러 — 서버 프록시로 Kollus 업로드 URL을 발급받고, 그 URL로 파일을 XHR 전송한다.
 */
async function handleUploadClick() {
    const file  = document.getElementById('fileInput').files[0];
    const title = document.getElementById('title').value.trim();

    if (!title) { alert('Please enter a title.'); return; }
    if (!file)  { alert('Please select a file.'); return; }

    setUploadButton(true, UPLOAD_BUTTON_LABEL_PROCESSING);

    try {
        // 1) 서버 프록시 /api/upload/create-url → Kollus Upload API create-url 호출.
        //    필드명은 서버 UploadCreateUrlRequest 프로퍼티와 일치하며 ExpireTime은 Kollus 폼 필드 규격대로 문자열로 보낸다.
        //    AccessToken을 비우면 서버가 Web.config의 토큰을 사용한다(토큰을 브라우저에 노출하지 않으려면 이 방식 권장)
        const res = await fetch('/api/upload/create-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                AccessToken:        document.getElementById('apiToken').value,
                ExpireTime:         String(DEFAULT_UPLOAD_EXPIRE_TIME),
                Title:              title,
                CategoryKey:        document.getElementById('categoryKey').value,
                IsEncryptionUpload: document.getElementById('isEncryption').value,
                IsAudioUpload:      document.getElementById('isAudio').value
            })
        });

        // Kollus 응답: { status: "ok", data: { upload_url, upload_file_key, progress_url } } — 실패 시 status가 "fail"
        const result = await res.json();
        if (result.status !== 'ok') throw new Error(JSON.stringify(result.error || result));

        document.getElementById('uploadDetails').innerHTML =
            '<p style="margin:0 0 6px;"><strong>Upload File Key:</strong> ' + result.data.upload_file_key + '</p>' +
            '<p style="margin:0;"><strong>Encoding Status:</strong> <a href="' + result.data.progress_url + '" target="_blank">Check progress</a></p>';
        document.getElementById('uploadInfo').style.display = 'block';
        document.getElementById('progressArea').style.display = 'block';

        // 2) 발급받은 upload_url로 브라우저가 파일을 직접 전송.
        //    multipart 필드명 'upload-file'은 Kollus 업로드 서버가 요구하는 고정 이름이다
        const formData = new FormData();
        formData.append('upload-file', file);

        const xhr = new XMLHttpRequest();
        xhr.upload.addEventListener('progress', handleUploadProgress);
        xhr.addEventListener('load', handleUploadLoad);
        xhr.addEventListener('error', handleUploadError);

        // Kollus 업로드 URL은 1회용이며 expire_time(초) 안에만 유효 — multipart/form-data POST로 받는다
        xhr.open('POST', result.data.upload_url);
        xhr.send(formData);
    } catch (err) {
        // 업로드 URL 발급 단계 실패(네트워크 오류, Kollus status "fail", JSON 파싱 실패) —
        // 아직 파일 전송 전이므로 원인을 알리고 버튼을 복구해 바로 재시도할 수 있게 한다
        alert('Error: ' + err.message);
        setUploadButton(false, UPLOAD_BUTTON_LABEL_IDLE);
    }
}

/**
 * XHR upload progress 이벤트 핸들러 — 전송된 바이트 비율로 진행률 바와 퍼센트 문구를 갱신한다.
 * @@param {ProgressEvent} event 업로드 진행 이벤트
 */
function handleUploadProgress(event) {
    if (!event.lengthComputable) return;
    const pct = Math.round(event.loaded / event.total * PERCENT_SCALE);
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('progressText').textContent = pct + '%';
}

/**
 * XHR load 이벤트 핸들러 — 2xx 응답이면 완료 안내를 표시하고, 그 외 상태면 실패를 알리고 버튼을 복구한다.
 * @@param {ProgressEvent} event load 이벤트 (event.target이 XMLHttpRequest)
 */
function handleUploadLoad(event) {
    const status = event.target.status;
    if (status >= HTTP_STATUS_SUCCESS_MIN && status <= HTTP_STATUS_SUCCESS_MAX) {
        setUploadButton(true, UPLOAD_BUTTON_LABEL_DONE);
        document.getElementById('completeInfo').style.display = 'block';
    } else {
        alert('Upload failed: ' + status);
        setUploadButton(false, UPLOAD_BUTTON_LABEL_IDLE);
    }
}

/**
 * XHR error 이벤트 핸들러 — 네트워크 단절 등으로 전송 자체가 실패한 경우 알리고 버튼을 복구한다.
 */
function handleUploadError() {
    alert('Network error occurred.');
    setUploadButton(false, UPLOAD_BUTTON_LABEL_IDLE);
}

document.getElementById('uploadBtn').addEventListener('click', handleUploadClick);
</script>
