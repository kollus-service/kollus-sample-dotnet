@* Player Sample — Web.config 채널 키와 화면 입력값(만료 시간·seek·재생 구간·워터마크 등)으로 /jwt/create를 호출해
   플레이어 JWT를 발급하고, 웹 플레이어(iframe)와 모바일 Kollus 앱(kollus:// / intent:// 스킴)으로 재생을 확인하는 페이지 *@
@{
    ViewBag.Title = "Kollus Player Sample";
}

<div style="max-width:720px; margin:50px auto;">
    <h2>Kollus Player Sample</h2>

    <!-- Basic Settings -->
    <div class="panel panel-default">
        <div class="panel-heading"><strong>Basic Settings</strong></div>
        <div class="panel-body">
            <div class="form-group">
                <label>Security Key</label>
                <input id="securityKey" type="text" class="form-control" value="@ViewBag.DefaultSecurityKey" />
            </div>
            <div class="form-group">
                <label>Custom Key</label>
                <input id="customKey" type="text" class="form-control" value="@ViewBag.DefaultCustomKey" />
            </div>
            <div class="form-group">
                <label>MCK (Media Content Key)</label>
                <input id="mck" type="text" class="form-control" value="@ViewBag.DefaultMck" placeholder="e.g. NNHk8cm6" />
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>CUID (Viewer ID)</label>
                        <input id="cuid" type="text" class="form-control" value="sample_user" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Expiry (minutes)</label>
                        <input id="expt" type="number" class="form-control" value="@ViewBag.DefaultExpireMinutes" min="1" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Advanced Options -->
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer;" onclick="handleToggleAdvanced()">
            <strong>Advanced Options</strong>
            <span id="advToggle" class="pull-right">&#9660;</span>
        </div>
        <div class="panel-body" id="advancedPanel" style="display:none;">

            <h5 style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:6px;">Seek</h5>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label><input type="checkbox" id="seekEnabled" checked /> Allow Seek</label>
                        <p class="help-block" style="font-size:12px;">Uncheck to disable scrubbing in the player.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Seekable End (sec)</label>
                        <input id="seekableEnd" type="number" class="form-control" value="0" min="0" />
                        <p class="help-block" style="font-size:12px;">0 = no limit. User can only seek up to this point.</p>
                    </div>
                </div>
            </div>

            <h5 style="border-bottom:1px solid #eee; padding-bottom:6px;">Intro / Outro</h5>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Intro MCK</label>
                        <input id="introMck" type="text" class="form-control" placeholder="MCK played before main content" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Outro MCK</label>
                        <input id="outroMck" type="text" class="form-control" placeholder="MCK played after main content" />
                    </div>
                </div>
            </div>

            <h5 style="border-bottom:1px solid #eee; padding-bottom:6px;">Play Section</h5>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Start (sec)</label>
                        <input id="sectionStart" type="number" class="form-control" value="0" min="0" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>End (sec)</label>
                        <input id="sectionEnd" type="number" class="form-control" value="0" min="0" />
                        <p class="help-block" style="font-size:12px;">0 = disabled. Restricts playback to this range.</p>
                    </div>
                </div>
            </div>

            <h5 style="border-bottom:1px solid #eee; padding-bottom:6px;">Playback Rate</h5>
            <div class="form-group">
                <label><input type="checkbox" id="disablePlayrate" /> Disable Playback Rate Control</label>
                <p class="help-block" style="font-size:12px;">Hides the speed control from the player UI.</p>
            </div>

            <h5 style="border-bottom:1px solid #eee; padding-bottom:6px;">Next Episode</h5>
            <div class="form-group">
                <label><input type="checkbox" id="nextEpisode" /> Enable Next Episode Callback</label>
                <p class="help-block" style="font-size:12px;">Player calls <code>/callback/next-episode</code> at end of content.</p>
            </div>

            <h5 style="border-bottom:1px solid #eee; padding-bottom:6px;">Watermark</h5>
            <div class="form-group">
                <label><input type="checkbox" id="watermark" onchange="handleToggleWatermarkDetail(this)" /> Enable Watermark (shows CUID)</label>
            </div>
            <div id="watermarkDetail" style="display:none;">
                <div class="row">
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>Font Size (px)</label>
                            <input id="wmFontSize" type="number" class="form-control" value="@ViewBag.DefaultWatermarkFontSize" />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>Color (HEX)</label>
                            <input id="wmColor" type="text" class="form-control" value="@ViewBag.DefaultWatermarkColor" />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>Alpha (0-255)</label>
                            <input id="wmAlpha" type="number" class="form-control" value="@ViewBag.DefaultWatermarkAlpha" min="0" max="255" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>Show Time (sec)</label>
                            <input id="wmShowTime" type="number" class="form-control" value="@ViewBag.DefaultWatermarkShowTime" />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>Hide Time (sec)</label>
                            <input id="wmHideTime" type="number" class="form-control" value="@ViewBag.DefaultWatermarkHideTime" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <button id="issueBtn" onclick="handleJwtIssue()" class="btn btn-primary btn-block">Generate &amp; Play</button>

    <div id="errorMsg" class="alert alert-danger" style="display:none; margin-top:12px;"></div>

    <!-- Player -->
    <div id="playerSection" style="display:none; margin-top:20px;">
        <div class="panel panel-default">
            <div class="panel-heading"><strong>Web Player</strong></div>
            <div class="panel-body" style="padding:0;">
                <div style="position:relative; width:100%; padding-top:56.25%;">
                    <iframe id="kollusIframe" src="about:blank"
                        style="position:absolute; top:0; left:0; width:100%; height:100%; border:none;"
                        allowfullscreen
                        webkitallowfullscreen
                        mozallowfullscreen
                        allow="encrypted-media; local-network-access">
                    </iframe>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><strong>Mobile Player</strong> <small>Kollus app required</small></div>
            <div class="panel-body">
                <a href="javascript:void(0);" onclick="handlePlayerCall('path')" class="btn btn-primary">Stream</a>
                <a href="javascript:void(0);" onclick="handlePlayerCall('download')" class="btn btn-success">Download</a>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><strong>JWT Info</strong></div>
            <div class="panel-body">
                <p style="margin:0 0 4px; font-size:12px; color:#888;">Token</p>
                <code id="jwtTokenDisplay" style="word-break:break-all; font-size:11px;"></code>
                <hr style="margin:10px 0;" />
                <p style="margin:0 0 4px; font-size:12px; color:#888;">Play URL</p>
                <a id="jwtLinkDisplay" href="#" target="_blank" style="word-break:break-all; font-size:11px;"></a>
            </div>
        </div>
    </div>
</div>

<script>
// ── 입력 기본값 (서버 KollusDefaults와 동일한 값을 ViewBag으로 받음) — 입력이 비어 있거나 숫자가 아닐 때 fallback ──
const DEFAULT_CUID                = 'sample_user';
const DEFAULT_EXPIRE_MINUTES      = @ViewBag.DefaultExpireMinutes;
const DEFAULT_WATERMARK_FONT_SIZE = @ViewBag.DefaultWatermarkFontSize;
const DEFAULT_WATERMARK_COLOR     = '@ViewBag.DefaultWatermarkColor';
const DEFAULT_WATERMARK_ALPHA     = @ViewBag.DefaultWatermarkAlpha;
const DEFAULT_WATERMARK_SHOW_TIME = @ViewBag.DefaultWatermarkShowTime;
const DEFAULT_WATERMARK_HIDE_TIME = @ViewBag.DefaultWatermarkHideTime;

// ── Kollus 모바일 재생 링크 / 앱 정보 ──
// SI 링크(/si?jwt=&custom_key=): 모바일 Kollus 앱이 여는 재생·다운로드 링크. 웹 플레이어 페이지(/s?)와 형식이 다르다
const KOLLUS_SI_LINK_BASE    = 'https://v.kr.kollus.com/si';
const KOLLUS_ANDROID_PACKAGE = 'com.kollus.media';
const IOS_APP_STORE_URL      = 'https://itunes.apple.com/us/app/kollusplayer/id760006888?l=ko&ls=1&mt=8';
const ANDROID_PLAY_STORE_URL = 'market://details?id=' + KOLLUS_ANDROID_PACKAGE;

// ── 앱 스킴 호출 타이밍 ──
// 숨김 iframe이 DOM에 붙은 뒤 스킴을 호출하도록 다음 tick(1ms)으로 미룸
const SCHEME_CALL_DEFER_MS = 1;
// iOS: 스킴 호출 후 3초가 지나도 페이지가 계속 보이면 앱 미설치로 판단해 App Store로 이동
const IOS_STORE_REDIRECT_DELAY_MS = 3000;
// iOS: 호출 후 4초 이상 지났다면 앱으로 전환됐다가 돌아온 것이므로(앱 설치됨) 스토어 이동을 생략
const IOS_APP_SWITCH_THRESHOLD_MS = 4000;
// Android(intent 미지원 브라우저): 1.5초 뒤에도 앱 전환이 없으면 Play 스토어로 이동
const ANDROID_STORE_REDIRECT_DELAY_MS = 1500;
// Android: 호출 후 2초 이내면 앱이 열리지 않은 것으로 판단 (앱으로 전환되면 타이머 자체가 지연됨)
const ANDROID_APP_SWITCH_THRESHOLD_MS = 2000;
// intent:// 스킴은 Android Chrome 25부터 지원 — 이 버전을 넘는 Chrome에서만 intent 경로를 쓰고 나머지는 kollus://로 fallback
const INTENT_SCHEME_MIN_CHROME_VERSION = 25;

let currentJwt       = null;
let currentCustomKey = null;

/**
 * Advanced Options 패널 헤더 클릭 핸들러 — 패널을 접거나 펼치고 화살표 아이콘을 바꾼다.
 */
function handleToggleAdvanced() {
    const panel  = document.getElementById('advancedPanel');
    const toggle = document.getElementById('advToggle');
    const show   = panel.style.display === 'none';
    panel.style.display = show ? 'block' : 'none';
    toggle.innerHTML = show ? '&#9650;' : '&#9660;';
}

/**
 * Enable Watermark 체크박스 변경 핸들러 — 체크 시 워터마크 세부 옵션(글꼴·색·표시 시간)을 보여준다.
 * @@param {HTMLInputElement} checkbox 워터마크 체크박스 요소
 */
function handleToggleWatermarkDetail(checkbox) {
    document.getElementById('watermarkDetail').style.display = checkbox.checked ? 'block' : 'none';
}

/**
 * Generate & Play 버튼 클릭 핸들러 — 입력값으로 /jwt/create를 호출해 JWT를 발급받고
 * 웹 플레이어 iframe과 JWT 정보 패널을 채운다.
 */
async function handleJwtIssue() {
    const mck = document.getElementById('mck').value.trim();
    if (!mck) { showError('Please enter an MCK.'); return; }

    document.getElementById('errorMsg').style.display = 'none';
    document.getElementById('playerSection').style.display = 'none';

    const btn = document.getElementById('issueBtn');
    btn.textContent = 'Issuing...';
    btn.disabled = true;

    // /jwt/create 요청 바디 — 필드명은 서버 JwtCreateRequest 프로퍼티와 일치해야 한다.
    // Expt는 분 단위(서버가 초로 환산해 JWT expt에 넣음), Security/Custom Key가 비면 서버가 Web.config 값을 사용.
    // seek·intro/outro·play section·watermark 등은 JWT 페이로드의 플레이어 옵션으로 들어간다
    const body = {
        Mck:              mck,
        Cuid:             document.getElementById('cuid').value.trim() || DEFAULT_CUID,
        Expt:             parseInt(document.getElementById('expt').value) || DEFAULT_EXPIRE_MINUTES,
        SecurityKey:      document.getElementById('securityKey').value.trim(),
        CustomKey:        document.getElementById('customKey').value.trim(),
        Seek:             document.getElementById('seekEnabled').checked,
        SeekableEnd:      parseInt(document.getElementById('seekableEnd').value) || 0,
        Intro:            document.getElementById('introMck').value.trim() || null,
        Outro:            document.getElementById('outroMck').value.trim() || null,
        PlaySectionStart: parseInt(document.getElementById('sectionStart').value) || 0,
        PlaySectionEnd:   parseInt(document.getElementById('sectionEnd').value) || 0,
        DisablePlayrate:  document.getElementById('disablePlayrate').checked,
        NextEpisode:      document.getElementById('nextEpisode').checked,
        Watermark:        document.getElementById('watermark').checked,
        WatermarkFontSize:  parseInt(document.getElementById('wmFontSize').value) || DEFAULT_WATERMARK_FONT_SIZE,
        WatermarkColor:     document.getElementById('wmColor').value.trim() || DEFAULT_WATERMARK_COLOR,
        WatermarkAlpha:     parseInt(document.getElementById('wmAlpha').value) || DEFAULT_WATERMARK_ALPHA,
        WatermarkShowTime:  parseInt(document.getElementById('wmShowTime').value) || DEFAULT_WATERMARK_SHOW_TIME,
        WatermarkHideTime:  parseInt(document.getElementById('wmHideTime').value) || DEFAULT_WATERMARK_HIDE_TIME
    };

    try {
        const res = await fetch('/jwt/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        // 응답: { Token, Link } — Link는 JWT가 담긴 웹 플레이어 URL(/s?jwt=&custom_key=), 실패 시 { error }
        const data = await res.json();
        if (data.error) { showError(data.error); return; }

        currentJwt       = data.Token;
        currentCustomKey = body.CustomKey;

        document.getElementById('kollusIframe').src = data.Link;
        document.getElementById('jwtTokenDisplay').textContent = data.Token;
        const linkEl = document.getElementById('jwtLinkDisplay');
        linkEl.href = data.Link;
        linkEl.textContent = data.Link;
        document.getElementById('playerSection').style.display = 'block';
    } catch (err) {
        // 네트워크 오류나 서버가 JSON이 아닌 응답(오류 페이지 등)을 보낸 경우 —
        // 원인을 화면에 보여주고, finally에서 버튼을 복구해 재시도할 수 있게 한다
        showError('Error: ' + err.message);
    } finally {
        btn.textContent = 'Generate & Play';
        btn.disabled = false;
    }
}

/**
 * 오류 메시지 영역에 메시지를 표시한다.
 * @@param {string} msg 표시할 메시지
 */
function showError(msg) {
    const el = document.getElementById('errorMsg');
    el.textContent = msg;
    el.style.display = 'block';
}

/**
 * 모바일 기기 여부를 판별한다. iPadOS 13+는 Macintosh UA를 보내므로 터치 지원 여부로 함께 판단한다.
 * @@returns {boolean} 모바일 기기이면 true
 */
function isMobile() {
    const ua = navigator.userAgent;
    return /Android|iPhone|iPad|iPod|BlackBerry|Windows Phone/i.test(ua) ||
           (/Linux/i.test(ua) && navigator.maxTouchPoints > 0) ||
           (ua.includes('Macintosh') && navigator.maxTouchPoints > 0);
}

/**
 * 현재 페이지가 화면에 보이는지 반환한다. 앱으로 전환되면 페이지가 숨김 상태가 되는 점을 스토어 이동 판단에 이용한다.
 * @@returns {boolean} 페이지가 보이면 true (Page Visibility API 미지원 브라우저는 항상 true)
 */
function isPageVisible() {
    return document.hidden !== undefined ? !document.hidden : true;
}

/**
 * 모바일 Kollus 앱을 커스텀 URL 스킴으로 호출한다. 앱이 설치되지 않아 화면 전환이 없으면 스토어로 보낸다.
 *  - iOS: kollus:// 스킴으로 이동한 뒤, 페이지가 계속 보이면 App Store로 이동
 *  - Android Chrome(25 초과): intent:// 스킴으로 패키지를 지정해 앱을 열고, 미설치 시 Chrome이 Play 스토어를 연다
 *  - 그 외 Android 브라우저: 숨김 iframe으로 kollus:// 스킴을 호출하고, 전환이 없으면 market://로 이동
 * @@param {string} schemePath 앱에 전달할 스킴 경로 — "path?url=..."(스트리밍) 또는 "download?url=..."(다운로드)
 */
function kollusSchemeCall(schemePath) {
    const ua    = navigator.userAgent.toLowerCase();
    const isIos = /iphone|ipad|ipod/.test(ua) || (ua.includes('macintosh') && navigator.maxTouchPoints > 0);

    // kollus://{path}?url={SI 링크} — Kollus 앱(iOS/Android 공통)이 등록한 커스텀 스킴
    const generalScheme = 'kollus://' + schemePath;
    // intent://{path}#Intent;package=com.kollus.media;scheme=kollus;end — Android Chrome 전용 intent URL.
    // package를 지정해 다른 앱이 가로채지 않게 하고, 미설치 시 Chrome이 해당 패키지의 Play 스토어 페이지로 안내한다
    const intentScheme  = 'intent://' + schemePath + '#Intent;package=' + KOLLUS_ANDROID_PACKAGE + ';scheme=kollus;end';

    // 페이지 이동 없이 스킴을 호출하기 위한 숨김 iframe (intent를 지원하지 않는 Android 브라우저 경로에서 사용)
    const iframe = document.createElement('iframe');
    iframe.style.display = 'none';
    document.body.appendChild(iframe);
    const calledAt = Date.now();

    setTimeout(function () {
        if (isIos) {
            // 앱으로 전환되면 페이지가 숨겨지므로 타이머 만료 시 페이지가 보이면 앱이 열리지 않은 것으로 본다.
            // 페이지가 다시 보이면(앱에서 복귀) 스토어 이동 타이머를 취소한다
            const storeTimer = setTimeout(function () {
                if (isPageVisible() && Date.now() - calledAt < IOS_APP_SWITCH_THRESHOLD_MS)
                    location.href = IOS_APP_STORE_URL;
            }, IOS_STORE_REDIRECT_DELAY_MS);
            /** 페이지가 다시 보이면(앱에서 복귀) 스토어 이동 타이머를 취소한다 */
            const handleVisibilityChange = function () { if (isPageVisible()) clearTimeout(storeTimer); };
            window.addEventListener('visibilitychange', handleVisibilityChange);
            location.href = generalScheme;
        } else {
            const chromeVersionMatch = navigator.appVersion.match(/Chrome\/(\d+\.\d+)/);
            const supportsIntent = ua.includes('chrome') && chromeVersionMatch
                && parseFloat(chromeVersionMatch[1]) > INTENT_SCHEME_MIN_CHROME_VERSION;
            // Daum 앱 내장 브라우저는 Chrome UA를 갖지만 intent://를 처리하지 못하므로 kollus:// 경로로 보낸다
            if (supportsIntent && !ua.includes('daum')) {
                location.href = intentScheme;
            } else {
                setTimeout(function () {
                    if (Date.now() - calledAt < ANDROID_APP_SWITCH_THRESHOLD_MS) location.href = ANDROID_PLAY_STORE_URL;
                }, ANDROID_STORE_REDIRECT_DELAY_MS);
                iframe.src = generalScheme;
            }
        }
    }, SCHEME_CALL_DEFER_MS);
}

/**
 * Mobile Player 버튼(Stream / Download) 클릭 핸들러 — 발급된 JWT로 SI 링크를 만들어 Kollus 앱을 호출한다.
 * @@param {string} method 앱 스킴 경로 — 'path'(스트리밍 재생) 또는 'download'(다운로드)
 */
function handlePlayerCall(method) {
    if (!currentJwt) { alert('Please issue a JWT first.'); return; }
    if (!isMobile()) { alert('Please run on a mobile device.'); return; }
    // 앱에는 웹 플레이어 링크(/s?)가 아닌 SI 링크(/si?jwt=&custom_key=)를 넘긴다 —
    // 앱이 JWT를 해석해 스트리밍 또는 다운로드를 수행하며, next-episode 콜백의 next_url도 같은 형식이다
    const siLink = KOLLUS_SI_LINK_BASE + '?jwt=' + currentJwt + '&custom_key=' + currentCustomKey;
    kollusSchemeCall(method + '?url=' + encodeURIComponent(siLink));
}
</script>
