@* Player Demo — DemoController가 Web.config의 기본 MCK로 발급한 플레이어 URL(ViewBag.PlayerUrl)을
   iframe에 바로 띄워 재생을 확인하는 페이지 *@
@{
    ViewBag.Title = "Kollus Player Demo";
}

<div style="max-width:800px; margin:50px auto;">
    <h1>Kollus Player Demo</h1>

    <div style="position:relative; width:100%; padding-top:56.25%;">
        <iframe
            src="@ViewBag.PlayerUrl"
            style="position:absolute; top:0; left:0; width:100%; height:100%; border:none;"
            allowfullscreen
            allow="local-network-access; loopback-network; accelerometer; autoplay; encrypted-media; fullscreen; picture-in-picture;">
        </iframe>
    </div>
</div>
